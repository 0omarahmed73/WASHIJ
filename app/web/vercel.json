{
  "rewrites": [
    { "source": "/artworks", "destination": "/index.html" },
    { "source": "/artwork/:path*", "destination": "/index.html" },
    { "source": "/artists", "destination": "/index.html" },
    { "source": "/artist/:path*", "destination": "/index.html" },
    { "source": "/movements", "destination": "/index.html" },
    { "source": "/movement/:path*", "destination": "/index.html" },
    { "source": "/readings", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/washij_service_worker.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json" }
      ]
    }
  ]
}

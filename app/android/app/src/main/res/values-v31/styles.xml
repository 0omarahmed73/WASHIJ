<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/washij_midnight</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenAnimationDuration">900</item>
        <item name="android:statusBarColor">@color/washij_midnight</item>
        <item name="android:navigationBarColor">@color/washij_midnight</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/washij_midnight</item>
        <item name="android:statusBarColor">@color/washij_midnight</item>
        <item name="android:navigationBarColor">@color/washij_midnight</item>
    </style>
</resources>
